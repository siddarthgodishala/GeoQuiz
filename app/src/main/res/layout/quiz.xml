<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/quiz_root" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/app_name" android:textSize="34sp" android:textStyle="bold" android:textColor="@color/ink" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/tagline" android:textSize="16sp" android:textColor="@color/secondary" android:layout_marginBottom="20dp" />
        <TextView android:id="@+id/score" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="21sp" android:textStyle="bold" android:textColor="@color/accent" android:accessibilityLiveRegion="polite" />
        <TextView android:id="@+id/completion" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="15sp" android:textColor="@color/secondary" android:layout_marginTop="4dp" />
        <ProgressBar android:id="@+id/completion_bar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="12dp" android:layout_marginTop="8dp" android:layout_marginBottom="16dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:labelFor="@id/question_picker" android:text="@string/selector_label" android:textSize="14sp" android:textColor="@color/secondary" />
        <Spinner android:id="@+id/question_picker" android:layout_width="match_parent" android:layout_height="56dp" android:spinnerMode="dropdown" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:background="@drawable/panel" android:layout_marginTop="10dp">
            <TextView android:id="@+id/category" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/accent" />
            <TextView android:id="@+id/statement" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="25sp" android:textColor="@color/ink" android:layout_marginTop="12dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="22dp">
                <Button android:id="@+id/choose_true" style="@style/ActionButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:background="@drawable/answer_surface" android:text="@string/true_button" android:layout_marginEnd="6dp" />
                <Button android:id="@+id/choose_false" style="@style/ActionButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:background="@drawable/answer_surface" android:text="@string/false_button" android:layout_marginStart="6dp" />
            </LinearLayout>
            <TextView android:id="@+id/feedback" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:textColor="@color/secondary" android:layout_marginTop="18dp" android:accessibilityLiveRegion="polite" />
            <TextView android:id="@+id/answer_lock" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/locked" android:textSize="14sp" android:textColor="@color/secondary" android:layout_marginTop="8dp" />
        </LinearLayout>
        <Button android:id="@+id/next" style="@style/ActionButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/next_button" android:layout_marginTop="16dp" />
        <Button android:id="@+id/open_review" style="@style/ActionButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/review_button" />
        <Button android:id="@+id/restart" style="@style/ActionButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/restart_button" />
    </LinearLayout>
</ScrollView>
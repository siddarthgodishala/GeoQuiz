<?xml version="1.0" ?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/app_name" android:textSize="32sp" android:textColor="#102A43" android:padding="12dp"/>
        <TextView android:id="@+id/intro" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/intro" android:textSize="16sp" android:textColor="#102A43" android:padding="12dp"/>
        <TextView android:id="@+id/progress" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/intro" android:textSize="16sp" android:textColor="#102A43" android:padding="12dp"/>
        <TextView android:id="@+id/question_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/q0" android:textSize="24sp" android:textColor="#102A43" android:padding="12dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button style="?android:attr/buttonBarButtonStyle" android:id="@+id/true_button" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="56dp" android:text="@string/true_label" android:layout_marginTop="8dp"/>
            <Button style="?android:attr/buttonBarButtonStyle" android:id="@+id/false_button" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="56dp" android:text="@string/false_label" android:layout_marginTop="8dp"/>
        </LinearLayout>
        <TextView android:id="@+id/feedback" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/unanswered" android:textSize="16sp" android:textColor="#102A43" android:padding="12dp"/>
        <TextView android:id="@+id/score" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/intro" android:textSize="20sp" android:textColor="#102A43" android:padding="12dp"/>
        <Button android:id="@+id/next_button" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:text="@string/next_label" android:layout_marginTop="8dp"/>
        <Button android:id="@+id/previous_button" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:text="@string/previous_label" android:layout_marginTop="8dp"/>
        <Button android:id="@+id/cheat_button" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:text="@string/cheat_label" android:layout_marginTop="8dp"/>
        <Button android:id="@+id/restart_button" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:text="@string/restart_label" android:layout_marginTop="8dp"/>
    </LinearLayout>
</ScrollView>
